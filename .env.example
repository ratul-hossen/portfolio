# Copy this file to .env.local for your computer, and add the same keys in
# Vercel → Project → Settings → Environment Variables for the live site.
# Everything is optional for a first `npm run dev`: on your own computer the
# admin panel opens without a login and saves to src/content/site.json.

# --- Admin login (Auth.js + Google) -----------------------------------------
# A long random string. Generate one with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only these accounts can sign in (comma-separated)
ADMIN_EMAILS=you@gmail.com

# Optional: also allow a Microsoft / Office 365 account (e.g. a university address)
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- Database (Neon) ---------------------------------------------------------
# Filled in automatically when you connect Neon in Vercel → Storage.
# With it, saves go live instantly and every save is kept in version history.
DATABASE_URL=

# --- File uploads (Vercel Blob) ----------------------------------------------
# Filled in automatically when you connect Blob in Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# --- Optional ----------------------------------------------------------------
# Require the Google login even on your own computer:
# ADMIN_REQUIRE_LOGIN=true
# Your public URL (sitemap, link previews). On Vercel it defaults to your
# production domain, so set this only for a custom domain:
# NEXT_PUBLIC_SITE_URL=https://yourname.com
