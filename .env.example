# Copy this file to .env.local for your computer, and add the same values in
# Vercel → Project → Settings → Environment Variables for the live site.
# Everything is optional for a first `npm run dev` — the admin panel opens
# without a login on your own computer until Google is set up.

# --- Admin login (Google) ---------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A long random string that signs the login cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Google accounts allowed into /admin, separated by commas.
ADMIN_EMAILS=you@gmail.com

# --- Editing on the live site ------------------------------------------------
# A fine-grained GitHub token with "Contents: Read and write" on this repo only.
# Saves in the admin panel become commits, and Vercel redeploys the site.
GITHUB_TOKEN=

# Only needed outside Vercel (Vercel fills these in from the connected repo):
# GITHUB_REPO=your-username/portfolio
# GITHUB_BRANCH=main

# --- Site address -------------------------------------------------------------
# Your public URL, used for the sitemap and link previews. On Vercel it
# defaults to your production domain, so set this only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://yourname.com
